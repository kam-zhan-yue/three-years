class_name DialogueCleanRoom extends DialogueScript

func get_dialogue() -> Array[Dialogue.Line]:
	return [
		Dialogue.Line.new(Game.Character.Alex, "So it's this time of the year again."),
		Dialogue.Line.new(Game.Character.Wato, "I can't believe three years (and a month) has passed by so fast."),
		Dialogue.Line.new(Game.Character.Alex, "Well. You know exactly what we're about to do."),
		Dialogue.Line.new(Game.Character.Wato, "Represent each other as gamified characters in an online multiplayer game in some attempt at showing affection and appreciation for all the time we spent together because that's one of the only ways you know how?"),
		Dialogue.Line.new(Game.Character.Alex, "..."),
		Dialogue.Line.new(Game.Character.Alex, "We're in a game?!"),
		Dialogue.Line.new(Game.Character.Wato, "I'd love to start my day, but the room is so messy!"),
		Dialogue.Line.new(Game.Character.Alex, "Classic Wato."),
		Dialogue.Line.new(Game.Character.Wato, "Hey, half of this is your stuff too, you know."),
		Dialogue.Line.new(Game.Character.Alex, "What's mine is your's and your's is mine, so it's all yours."),
		Dialogue.Line.new(Game.Character.Wato, "Makes sense to me."),
		Dialogue.Line.new(Game.Character.Alex, "Anyways, we should definitely clean up this room before we start our day."),
		Dialogue.Line.new(Game.Character.Wato, "Do you remember how to clean?"),
		Dialogue.Line.new(Game.Character.Alex, "Hahaha, I wasn't born yesterday. Of course I know how to clean"),
		Dialogue.Line.new(Game.Character.Alex, "You use WASD to move to something you want to clean, then press and hold E to clean it up."),
		Dialogue.Line.new(Game.Character.Wato, "And you think we're not in a game?"),
		Dialogue.Line.new(Game.Character.Alex, "Isn't this how everyone does it?!"),
	]
